# Second Sight — backend env (set these in Vercel → Project → Settings →
# Environment Variables). Never commit real keys.

# Required for the AI vision features (Describe / Read / Medicine / Translate / Ask)
OPENAI_API_KEY=

# Optional — adds "what this drug treats" info after a medicine label read
EXA_API_KEY=

# Optional — walking navigation (free key from openrouteservice.org)
ORS_API_KEY=

# Optional — durable storage for family location sharing.
# Add a Vercel KV (or Upstash Redis) integration and these are set for you.
# Without them, location sharing still works in-memory for a quick demo.
KV_REST_API_URL=
KV_REST_API_TOKEN=
